import { Button } from "std-widgets.slint";

component QuickAction inherits Button {
    in property <string> description;
    min-height: 56px;
    accessible-label: self.text;
    accessible-description: self.description;
}

component StepButton inherits Button {
    in property <string> description;
    in property <bool> selected;
    primary: root.selected;
    min-height: 44px;
    accessible-label: self.description;
    accessible-checkable: true;
    accessible-checked: root.selected;
}

export component PanelWindow inherits Window {
    width: 360px;
    height: 600px;
    title: "PC Assistant";
    no-frame: true;
    always-on-top: true;
    forward-focus: keys;

    callback close-requested();
    callback action-triggered(string);
    callback zoom-step-selected(int);
    in property <string> status-text;
    in property <int> zoom-percent: 100;
    in property <int> zoom-step: 100;

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            accessible-role: none;

            HorizontalLayout {
                Text {
                    text: "PC Assistant";
                    font-size: 24px;
                    vertical-alignment: center;
                    accessible-role: text;
                    accessible-label: "PC Assistant";
                }
                Rectangle { }
                Button {
                    text: "Schließen";
                    accessible-label: "Schließen";
                    clicked => { root.close-requested(); }
                }
            }
            VerticalLayout {
                spacing: 8px;

                QuickAction {
                    text: "Zoom";
                    description: "Bildschirmzoom umschalten";
                    clicked => { root.action-triggered("zoom"); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    QuickAction {
                        text: "−";
                        accessible-label: "Verkleinern";
                        description: "Bildschirmzoom um eine Stufe verkleinern";
                        clicked => { root.action-triggered("zoom-out"); }
                    }
                    Text {
                        text: root.zoom-percent + " %";
                        font-size: 28px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        accessible-role: text;
                        accessible-label: "Zoom " + root.zoom-percent + " Prozent";
                    }
                    QuickAction {
                        text: "+";
                        accessible-label: "Vergrößern";
                        description: "Bildschirmzoom um eine Stufe vergrößern";
                        clicked => { root.action-triggered("zoom-in"); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    StepButton {
                        text: "100 %";
                        description: "Schrittweite 100 Prozent";
                        selected: root.zoom-step == 100;
                        clicked => { root.zoom-step-selected(100); }
                    }
                    StepButton {
                        text: "50 %";
                        description: "Schrittweite 50 Prozent";
                        selected: root.zoom-step == 50;
                        clicked => { root.zoom-step-selected(50); }
                    }
                    StepButton {
                        text: "10 %";
                        description: "Schrittweite 10 Prozent";
                        selected: root.zoom-step == 10;
                        clicked => { root.zoom-step-selected(10); }
                    }
                }
                QuickAction {
                    text: "Reset";
                    accessible-label: "Zoom zurücksetzen";
                    description: "Bildschirmzoom auf 100 Prozent zurücksetzen";
                    clicked => { root.action-triggered("zoom-reset"); }
                }
                QuickAction {
                    text: "Vorlesen";
                    description: "Vorlesen umschalten";
                    clicked => { root.action-triggered("tts"); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    QuickAction {
                        text: "Pause/Weiter";
                        accessible-label: "Vorlesen pausieren oder fortsetzen";
                        description: "Vorlesen pausieren oder fortsetzen";
                        clicked => { root.action-triggered("speak-pause"); }
                    }
                    QuickAction {
                        text: "Stopp";
                        accessible-label: "Vorlesen stoppen";
                        description: "Vorlesen beenden";
                        clicked => { root.action-triggered("speak-stop"); }
                    }
                }
                QuickAction {
                    text: "Mikrofon";
                    description: "Mikrofon umschalten";
                    clicked => { root.action-triggered("mic"); }
                }
                QuickAction {
                    text: "Kontrast";
                    description: "Hohen Kontrast umschalten";
                    clicked => { root.action-triggered("contrast"); }
                }
                QuickAction {
                    text: "Einstellungen";
                    description: "Einstellungen öffnen";
                    clicked => { root.action-triggered("settings"); }
                }
            }
            // Slint hat keine Live-Region; schlichter Text mit Label.
            Text {
                text: root.status-text;
                wrap: word-wrap;
                accessible-role: text;
                accessible-label: root.status-text;
            }
            Rectangle { }
        }
    }

    public function focus-panel() {
        keys.focus();
    }

    init => { keys.focus(); }
}
